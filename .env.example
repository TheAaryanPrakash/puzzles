# Copy to .env.local (gitignored) and fill in. See PLAN.md "Supabase" for how to get these values.

# Which DataSource the app uses (src/lib/data/index.ts). Game agents and local dev leave this
# unset or "local" — no Supabase project needed. Set to "supabase" for the real backend.
VITE_DATA_SOURCE=local

# Your Supabase project's URL and anon (public) key. Not secret — safe to ship in the client
# bundle (every request they make is still subject to RLS) and required by both the app
# (VITE_-prefixed, so Vite inlines them) and scripts/upload-puzzles.ts (needs the URL only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service role key: bypasses every RLS policy. Used ONLY by scripts/upload-puzzles.ts, run
# locally with `npx tsx`. Must NEVER be VITE_-prefixed (Vite would inline it into the client
# bundle) and must NEVER be set in Vercel's environment variables — the script refuses to run
# without exactly this name, and refuses if it finds a VITE_-prefixed copy instead.
SUPABASE_SERVICE_ROLE_KEY=
